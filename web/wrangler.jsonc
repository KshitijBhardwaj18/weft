{
  // Weft on Cloudflare Workers (OpenNext). FalkorDB runs on FalkorDB Cloud; set FALKORDB_URL,
  // ANTHROPIC_API_KEY and SESSION_SECRET with `wrangler secret put`.
  "name": "weft",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [{ "pattern": "weft.kshitijbhardwaj.space", "custom_domain": true }],
  "observability": { "enabled": true }
}
