# FalkorDB (docker compose maps it to 6380)
FALKORDB_URL=falkor://localhost:6380
# Claude, for Weft / Shuttle / Pattern
ANTHROPIC_API_KEY=

# Optional integrations: each is skipped cleanly when unset
APP_URL=http://localhost:3000
# Shopify custom app (Admin API): scopes read_orders, read_all_orders, read_products, read_inventory
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_SECRET=
# Resend, for supplier PO and check-in emails
RESEND_API_KEY=
RESEND_FROM=Weft <onboarding@resend.dev>
# WhatsApp Cloud API, for supplier check-ins and inbound supplier messages
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PO_TEMPLATE=po_update

# Signs supplier links (email/WhatsApp). Set a long random value in production.
SESSION_SECRET=
